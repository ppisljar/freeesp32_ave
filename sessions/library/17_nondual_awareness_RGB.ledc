# 17_nondual_awareness_RGB.ledc — Non-Dual Awareness, RGB inner/outer build
# RGB variant of 17_nondual_awareness. Audio + speech IDENTICAL (steady 7 Hz open hold).
# LEDs on inner ring (mask 9, violet-blue 60,30,200) + outer ring (mask 6, calm blue
# 32,96,255), 180 antiphase, SINE gate — spacious and steady, the slow breathing LFO the
# only movement. Every rate <=10 Hz; brightness <=22%. See base header for safety.
#
# LED: time freq duty bright R G B mask [env phase]

# --- Brief settle / alpha (beat 10 Hz): vol + light fade in ---
0 10 50 >0 60 30 200 9 1 0       # inner violet-blue: 10 Hz sine, fade-in
0 10 50 >0 32 96 255 6 1 180     # outer blue: antiphase
A 0 200 0 >0 0 1 210 0            # binaural: carrier 200 / R210 => 10 Hz beat; vol fade-in
S 3000 default 10 "Settle, and let the breath find its own rhythm. Nowhere to go, nothing to fix."
15000 10 50 18 60 30 200 9 1 0   # inner: 18% reached
15000 10 50 18 32 96 255 6 1 180 # outer
30000 10 50 ~8:22:12000 60 30 200 9 1 0   # inner: slow breathing 8<->22%
30000 10 50 ~8:22:12000 32 96 255 6 1 180 # outer
A 60000 200 0 100 0 1 210 0       # alpha settle holds

# --- Descend to the theta-alpha border (beat 10->7) ---
A 300000 >200 0 100 0 1 210 0     # carrier 200->203 (beat 10->7)
300000 >10 50 ~8:22:12000 60 30 200 9 1 0   # inner: 10->7 lockstep
300000 >10 50 ~8:22:12000 32 96 255 6 1 180 # outer
S 300000 default 10 "Let awareness open and rest wherever it is. Choose nothing; receive everything."

# --- Long FLAT open hold (beat 7 Hz, deliberately steady) ---
A 390000 203 0 100 0 1 210 0      # carrier 203 => beat 7 Hz held flat
390000 7 50 ~8:22:12000 60 30 200 9 1 0    # inner: dim violet-blue 7 Hz
390000 7 50 ~8:22:12000 32 96 255 6 1 180  # outer
S 600000 default 10 "Rest in open awareness — nothing to do, nothing to hold."
S 1080000 default 10 "Let awareness be vast and still, like a clear sky holding every passing cloud."

# --- Gentle return (beat 7->10) ---
A 1560000 >203 0 100 0 1 210 0    # carrier 203->200 (beat 7->10)
1560000 >7 50 ~8:22:12000 60 30 200 9 1 0   # inner: 7->10 lockstep
1560000 >7 50 ~8:22:12000 32 96 255 6 1 180 # outer
S 1560000 default 10 "Gently returning, carrying this stillness with you."

# --- Soft close: vol + brightness fade to 0 over 60 s ---
A 1740000 200 0 >100 0 1 210 0    # beat alpha 10; vol 50->0
1740000 10 50 >18 60 30 200 9 1 0    # inner: bright 18->0
1740000 10 50 >18 32 96 255 6 1 180  # outer
S 1740000 default 10 "Back at ten hertz. Gently return to the room, spacious and rested."
A 1800000 200 0 0 0 1 210 0       # volume 0
1800000 10 50 0 60 30 200 9 1 0      # inner off
1800000 10 50 0 32 96 255 6 1 180    # outer off

S 1800000 default 20 "WAKE UP!"
S 1810000 default 40 "WAKE UP!"
S 1820000 default 50 "WAKE UP!"
S 1830000 default 60 "WAKE UP!"
