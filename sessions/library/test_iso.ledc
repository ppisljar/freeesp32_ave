# test_iso.ledc — ISOLATION test for the test2 problems. Reproduces only the suspect steps,
# each self-contained (all 8 channels set up per segment), so we can see which one misbehaves:
#   seg A (0s)   = step 3  (AM / amplitude modulation)        — "things go wrong"
#   seg B (15s)  = step 6  (hard stereo panning)              — "gets worse"
#   seg C (30s)  = step 12 heavy state, then step-13 FADE     — "freezes / watchdog"
#   seg D (50s)  = step 1  (known-good baseline) AFTER the fade — proves the freeze is step 13,
#                  not the act of stopping (if we reach seg D, the fade completed).
# 8 audio channels max. Play via web app (S speech baked into BG).

# ===== seg A @ 0 s — STEP 3: amplitude modulation (mod field, default env=4 sine tremolo) =====
S 0 default 10 "this is a test"
S 2000 default 10 "step three, amplitude modulation"
0 0 50 ~10:60:4000 0 200 255 1
A 0 220 0 50 3 1                    # ch1 AM 3 Hz
A 0 247 0 50 6 2                    # ch2 AM 6 Hz
A 0 262 0 50 10 3                   # ch3 AM 10 Hz
A 0 294 0 50 8 4                    # ch4 AM 8 Hz
A 0 0 40 30 0 5 0 4                 # ch5 white noise
A 0 180 0 50 0 6 185                # ch6 binaural 5 Hz
A 0 220 0 50 0 7 0                  # ch7 mono
A 0 330 0 50 8 8                    # ch8 AM 8 Hz

# ===== seg B @ 15 s — STEP 6: hard stereo panning (pan -100/+100) =====
S 15000 default 10 "this is a test"
S 17000 default 10 "step six, hard panning"
15000 8 50 40 255 160 0 1 1 0
15000 8 50 40 0 100 255 2 1 180
A 15000 220 -100 50 0 1             # ch1 hard left (AM off: mod 0)
A 15000 247 0 50 0 2               # ch2 center
A 15000 262 100 50 0 3             # ch3 hard right
A 15000 440 -100 45 0 4            # ch4 stereo pair L
A 15000 0 40 30 0 5 0 4            # ch5 white noise
A 15000 180 0 50 0 6 185           # ch6 binaural
A 15000 220 0 50 0 7 0             # ch7 mono
A 15000 440 100 45 0 8            # ch8 stereo pair R

# ===== seg C @ 30 s — STEP 12 heavy state (3 noise + 2 binaural) — plays fine in test2 =====
S 30000 default 10 "this is a test"
S 32000 default 10 "step thirteen, the fade"
30000 4 50 40 0 0 255 1 0
30000 40 50 40 255 0 0 8 0
A 30000 120 -40 50 0 1 124         # ch1 binaural 4 Hz
A 30000 400 40 50 0 2 410          # ch2 binaural 10 Hz
A 30000 120 -40 50 0 3 124         # ch3 binaural 4 Hz
A 30000 400 40 50 0 4 410          # ch4 binaural 10 Hz
A 30000 247 0 40 0 5 0 4           # ch5 white noise
A 30000 262 0 40 0 6 0 5           # ch6 pink noise
A 30000 220 0 40 0 7 0 6           # ch7 brown noise
A 30000 330 0 50 0 8               # ch8 sine

# ----- STEP 13 FADE @ 40 s — the exact fade that froze in test2 ('>' ramp + '-' sentinels) -----
A 40000 - - >50 - 1
A 40000 - - >50 - 2
A 40000 - - >50 - 3
A 40000 - - >50 - 4
A 40000 - - >40 - 5
A 40000 - - >40 - 6
A 40000 - - >40 - 7
A 40000 - - >50 - 8
40000 4 50 >40 0 0 255 1 0
A 45000 - - 0 - 1                  # fade targets -> 0 (5 s)
A 45000 - - 0 - 2
A 45000 - - 0 - 3
A 45000 - - 0 - 4
A 45000 - - 0 - 5
A 45000 - - 0 - 6
A 45000 - - 0 - 7
A 45000 - - 0 - 8
45000 4 50 0 0 0 255 1 0

# ===== seg D @ 50 s — STEP 1 baseline AFTER the fade: if we hear this, step 13 didn't hang =====
S 50000 default 10 "this is a test"
S 52000 default 10 "step one again, recovery"
50000 0 50 40 255 160 0 1
A 50000 220 -60 50 0 1 0 0         # ch1 sine
A 50000 247 -20 50 0 2 0 1         # ch2 square
A 50000 262 0 50 0 3 0 2           # ch3 triangle
A 50000 294 20 50 0 4 0 3          # ch4 saw
A 50000 0 40 30 0 5 0 4            # ch5 white noise
A 50000 0 60 30 0 6 0 5            # ch6 pink noise
A 50000 0 -40 30 0 7 0 6           # ch7 brown noise
A 50000 330 0 50 0 8 0 0           # ch8 sine

# ===== 62 s — clean fade-out =====
S 62000 default 10 "this is a test"
A 62000 - - >50 - 1
A 62000 - - >50 - 2
A 62000 - - >50 - 3
A 62000 - - >50 - 4
A 62000 - - >30 - 5
A 62000 - - >30 - 6
A 62000 - - >30 - 7
A 62000 - - >50 - 8
62000 0 50 >40 255 160 0 1
A 67000 - - 0 - 1
A 67000 - - 0 - 2
A 67000 - - 0 - 3
A 67000 - - 0 - 4
A 67000 - - 0 - 5
A 67000 - - 0 - 6
A 67000 - - 0 - 7
A 67000 - - 0 - 8
67000 0 50 0 255 160 0 1
