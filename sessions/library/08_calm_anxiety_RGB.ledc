# 08_calm_anxiety_RGB.ledc — Calm / Anxiety, RGB inner/outer build
# RGB variant of 08_calm_anxiety. Audio + speech IDENTICAL (binaural alpha driver).
# The LED is calming ambient ONLY (never a driver): STEADY (freq 0), dim, with a slow
# breathing brightness LFO. On this build it is an inner deep-blue core (mask 9,
# 0,60,180) + an outer calm-blue halo (mask 6, 32,96,255) — no flicker at all.
# Brightness <=28%, floored at 12% (never full black<->white). See base header.
#
# LED: time freq duty bright R G B mask   (freq 0 = STEADY, no flicker)

# --- t=0: start (steady dim blue, brightness ramp-in) ---
0 0 50 >0 0 60 180 9        # inner deep-blue core: steady, bright fade-in
0 0 50 >0 32 96 255 6       # outer calm-blue halo: steady
A 0 >370 0 >0 0 1 382 0      # ch1 carrier >370; vol fade-in; freq_r 382 (beat 12); sine
S 3000 default 10 "Settling now at twelve hertz. Let your breathing slow, gently in and out."
15000 0 50 22 0 60 180 9    # inner: 22% reached
15000 0 50 22 32 96 255 6   # outer

# --- t=30 s: breathing brightness LFO (sine 12<->28% / 10 s) ---
30000 0 50 ~12:28:10000 0 60 180 9    # inner breathing
30000 0 50 ~12:28:10000 32 96 255 6   # outer breathing
A 45000 >370.5 0 100 0 1 382 0        # vol 50; carrier mid-slide; beat ~11.5 Hz
S 45000 default 10 "Easing down toward alpha. There is nothing you need to do right now."

# --- t=3:00: alpha reached (beat 10 Hz) — HOLD ~21 min ---
A 180000 372 0 100 0 1 382 0          # carrier 372 => beat 10 Hz; HOLD begins
S 180000 default 10 "You've reached alpha, ten hertz. Rest here, calm and safe. You are okay."

# --- t=24:30: soft close (stays in alpha) ---
A 1470000 372 0 >100 0 1 382 0        # vol 50 -> 0 over the last 30 s
S 1470000 default 10 "Slowly returning now, still calm and clear. Carry this ease with you."
1470000 0 50 >12 0 60 180 9           # inner: bright (LFO floor 12) -> 0
1470000 0 50 >12 32 96 255 6          # outer

# --- t=25:00: end ---
A 1500000 372 0 0 0 1 382 0           # volume 0
1500000 0 50 0 0 60 180 9             # inner off
1500000 0 50 0 32 96 255 6            # outer off

S 1500000 default 20 "WAKE UP!"
S 1510000 default 40 "WAKE UP!"
S 1520000 default 50 "WAKE UP!"
S 1530000 default 60 "WAKE UP!"
