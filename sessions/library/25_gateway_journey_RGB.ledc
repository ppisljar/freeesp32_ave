# 25_gateway_journey_RGB.ledc — Gateway Journey (F10->12->15->21), RGB inner/outer build
# RGB variant of 25_gateway_journey. Audio + speech IDENTICAL (a full walk up the Gateway
# levels; HEADPHONES REQUIRED; the 16.2 Hz F21 beta is AUDIO-ONLY). LED pinned to 4 Hz
# theta the whole session (NEVER the 16 Hz beat). On this build: inner violet (mask 9,
# 120,60,200) + outer calm-blue (mask 6, 32,96,255), 180 antiphase, SINE gate. Brightness
# <=25%. See base header for full method/safety.
#
# LED: time freq duty bright R G B mask [env phase]

# --- Prep / fade-in ---
0 4 50 >0 120 60 200 9 1 0      # inner violet: 4 Hz sine, fade-in
0 4 50 >0 32 96 255 6 1 180     # outer blue: antiphase
A 0 100 0 >0 0 1 101.5 7  # ch1 100[1.5] delta: vol 0->60; sine
A 0 200 ~-100:100:6000 >0 0 14 0 5   # pink bed ch14: 6 s L<->R pan, vol 0->8 (wave 5)
S 3000 default 47 "Relax and let the body settle. We will travel inward, one gentle threshold at a time."
15000 4 50 18 120 60 200 9 1 0  # inner: 18% reached
15000 4 50 18 32 96 255 6 1 180 # outer
30000 4 50 ~10:22:12000 120 60 200 9 1 0   # inner: breathing 10<->22%
30000 4 50 ~10:22:12000 32 96 255 6 1 180  # outer
A 60000 100 0 60 0 1 101.5 7  # ch1 vol 60; delta anchor held
A 60000 200 ~-100:100:6000 8 0 14 0 5   # pink bed -18 dB steady

# --- Focus 10 ---
A 180000 200 0 >0 0 2 204 7  # ch2 fades in 0->60
A 240000 200 0 60 0 2 204 7
A 180000 250 0 >0 0 3 254 7  # ch3 fades in
A 240000 250 0 60 0 3 254 7
A 180000 300 0 >0 0 4 304 7  # ch4 fades in
A 240000 300 0 60 0 4 304 7
S 180000 default 47 "Entering Focus 10. The body is asleep, the mind awake, still, and clear."

# --- Focus 12 (alpha signature, audio-only) ---
A 600000 400 0 >0 0 5 410 7  # ch5 alpha fades in 0->35
A 660000 400 0 35 0 5 410 7
A 600000 500 0 >0 0 6 510.1 7  # ch6 alpha fades in
A 660000 500 0 35 0 6 510.1 7
A 600000 600 0 >0 0 7 604.8 7  # ch7 4.8 Hz fades in
A 660000 600 0 45 0 7 604.8 7
S 600000 default 47 "Expanding now into Focus 12 — awareness opening wide, beyond the body."

# --- Focus 15 (alpha out, 7 Hz in) ---
A 1080000 400 0 >35 0 5 410 7  # ch5 alpha fades out
A 1140000 400 0 0 0 5 410 7
A 1080000 500 0 >35 0 6 510.1 7  # ch6 alpha fades out
A 1140000 500 0 0 0 6 510.1 7
A 1080000 600 0 >45 0 7 604.8 7  # ch7 fades out
A 1140000 600 0 0 0 7 604.8 7
A 1080000 500 0 >0 0 8 507.05 7  # ch8 7.05 Hz fades in 0->40
A 1140000 500 0 40 0 8 507.05 7
A 1080000 630 0 >0 0 9 637.1 7  # ch9 7.1 Hz fades in
A 1140000 630 0 40 0 9 637.1 7
A 1080000 750 0 >0 0 10 757 7  # ch10 7.0 Hz fades in
A 1140000 750 0 40 0 10 757 7
S 1080000 default 47 "Into Focus 15, where time falls away. No past, no future, only this open stillness."

# --- Focus 21 (7 Hz out, 16.2 Hz beta in — AUDIO ONLY) ---
A 1560000 100 0 >60 0 1 101.5 7  # ch1 delta fades out
A 1620000 100 0 0 0 1 101.5 7
A 1560000 500 0 >40 0 8 507.05 7  # ch8 theta-7 fades out
A 1620000 500 0 0 0 8 507.05 7
A 1560000 630 0 >40 0 9 637.1 7  # ch9 fades out
A 1620000 630 0 0 0 9 637.1 7
A 1560000 750 0 >40 0 10 757 7  # ch10 fades out
A 1620000 750 0 0 0 10 757 7
A 1560000 600 0 >0 0 11 616.2 7  # ch11 BETA 16.2 fades in 0->35 (audio-only)
A 1620000 600 0 35 0 11 616.2 7
A 1560000 750 0 >0 0 12 766.2 7  # ch12 BETA 16.2 fades in
A 1620000 750 0 35 0 12 766.2 7
A 1560000 900 0 >0 0 13 916.2 7  # ch13 BETA 16.2 fades in
A 1620000 900 0 35 0 13 916.2 7
S 1560000 default 47 "Focus 21 — the bridge, the far edge of the known. The 200, 250, and 300 theta layers hold you steady."
S 1800000 default 47 "Rest at the bridge. Reach out gently, then let yourself begin to return."

# --- Return: beta out, descend through the levels ---
A 2040000 200 ~-100:100:6000 >8 0 14 0 5 # pink bed begins slow fade
A 2040000 600 0 >35 0 11 616.2 7  # ch11 beta fades out
A 2160000 600 0 0 0 11 616.2 7
A 2040000 750 0 >35 0 12 766.2 7  # ch12 beta fades out
A 2160000 750 0 0 0 12 766.2 7
A 2040000 900 0 >35 0 13 916.2 7  # ch13 beta fades out
A 2160000 900 0 0 0 13 916.2 7
A 2040000 100 0 >0 0 1 101.5 7  # ch1 delta anchor fades back in 0->60
A 2160000 100 0 60 0 1 101.5 7
S 2040000 default 47 "Descending now, step by step, back through the levels toward the familiar."

# --- Soft close ---
A 2280000 100 0 >60 0 1 101.5 7  # ch1 fades out
A 2400000 100 0 0 0 1 101.5 7
A 2280000 200 0 >60 0 2 204 7  # ch2 fades out
A 2400000 200 0 0 0 2 204 7
A 2280000 250 0 >60 0 3 254 7  # ch3 fades out
A 2400000 250 0 0 0 3 254 7
A 2280000 300 0 >60 0 4 304 7  # ch4 fades out
A 2400000 300 0 0 0 4 304 7
2280000 4 50 >18 120 60 200 9 1 0    # inner: brightness 18->0
2280000 4 50 >18 32 96 255 6 1 180   # outer
S 2280000 default 47 "Coming all the way back to the room now, calm, whole, and refreshed."
A 2400000 200 ~-100:100:6000 0 0 14 0 5 # pink bed reaches 0
2400000 4 50 0 120 60 200 9 1 0      # inner off
2400000 4 50 0 32 96 255 6 1 180     # outer off
