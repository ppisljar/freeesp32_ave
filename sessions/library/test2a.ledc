# test2a.ledc — feature-coverage test, part A of 3 (audio carriers + panning; basic LED).
# Self-contained: at t=0 all 8 audio channels (ch1..ch8) and the initial LED are set up.
# Channels PERSIST once set, so each 10 s step only re-issues the channels whose feature
# changes. Strict 10 s steps (0,10000,20000,...), then a ~5 s fade of all 8 audio ch + LED.
# EXACTLY 8 audio channels live at once, never more. Audio vols moderate (~40..60, noise ~30).
# S speech lines are browser-only (baked on Play) and DON'T count toward the device cap.
# Play via the web app.
#
# Coverage in this file:
#   Audio: all 7 waveTypes (0..6); binaural (several beats) + mono (freqR=0); AM (mod) several
#          rates + mod sweep (>); panning L/C/R + hard-panned L/R stereo pair.
#   LED:   flicker at several rates + steady (freq 0); colours R/G/B + white; brightness
#          periodic mod (^ triangle glyph).
#
# Fields —  LED:   <time> <freq> <duty> <bright> <R> <G> <B> <mask> [env phase attack jitter]
#           AUDIO: A <time> <freq> <pan> <vol> <mod> [ch freqR waveType duty env phase attack jitter]
#   waveType: 0 sine 1 square 2 triangle 3 saw 4 white 5 pink 6 brown
#   glyphs: >lin *quad ~sine ^tri /sawup \sawdn _square ; '-' = keep current

# ===== 0 s — STEP one — all 7 waveTypes across ch1..ch8 (2nd sine on ch8)
#            LED: steady amber (freq 0, no flicker), colour amber, mask 1
S 0 default 20 "this is a test"
S 2000 default 20 "one"
0 0 50 45 255 160 0 1
A 0 220 -60 50 0 1 0 0          # ch1 sine (waveType 0), panned left
A 0 247 -20 50 0 2 0 1          # ch2 square (waveType 1)
A 0 262  0  50 0 3 0 2          # ch3 triangle (waveType 2)
A 0 294  20 50 0 4 0 3          # ch4 saw (waveType 3)
A 0 0    40 30 0 5 0 4          # ch5 white noise (waveType 4), vol lower (noise is hot)
A 0 0    60 30 0 6 0 5          # ch6 pink noise (waveType 5)
A 0 0   -40 30 0 7 0 6          # ch7 brown noise (waveType 6)
A 0 330  0  50 0 8 0 0          # ch8 sine (waveType 0)

# ===== 10 s — STEP two — binaural beats (4/10/40/5 Hz) + mono collapse (freqR=0)
#            LED: 10 Hz blue flicker (alpha), colour blue, mask 1
S 10000 default 20 "this is a test"
S 12000 default 20 "two"
10000 10 50 40 0 128 255 1
A 10000 120 0 50 0 1 124        # ch1 binaural 4 Hz beat (freqR-freq = 4)
A 10000 200 0 50 0 2 210        # ch2 binaural 10 Hz beat
A 10000 300 0 50 0 3 340        # ch3 binaural 40 Hz beat
A 10000 180 0 50 0 6 185        # ch6 binaural 5 Hz beat (was pink noise)
A 10000 220 0 50 0 7 0          # ch7 mono collapse (freqR=0) (was brown noise)

# ===== 20 s — STEP three — amplitude modulation (mod>0) at several rates + a mod sweep (>)
#            LED: 4 Hz red flicker (theta), colour red, mask 1
S 20000 default 20 "this is a test"
S 22000 default 20 "three"
20000 4 50 40 255 0 0 1
A 20000 220 0 50 3  1           # ch1 AM 3 Hz
A 20000 247 0 50 6  2           # ch2 AM 6 Hz
A 20000 262 0 50 10 3           # ch3 AM 10 Hz
A 20000 294 0 50 >4 4           # ch4 AM rate ramp (mod sweep 4 -> 12 Hz over step)
A 30000 - - - 12 4             # ch4 mod-sweep target (mod 4 -> 12); freq/pan/vol held with '-'

# ===== 30 s — STEP four — panning: hard L / center / hard R + a hard-panned L/R stereo pair
#            LED: steady green (freq 0), colour green, mask 1
S 30000 default 20 "this is a test"
S 32000 default 20 "four"
30000 0 50 45 0 255 0 1
A 30000 220 -100 50 0 1         # ch1 hard left (also clears AM: mod back to 0)
A 30000 247  0   50 0 2         # ch2 center
A 30000 262  100 50 0 3         # ch3 hard right
A 30000 440 -100 45 0 4         # ch4 stereo pair L
A 30000 440  100 45 0 8         # ch8 stereo pair R (same 440 Hz, hard L/R)

# ===== 40 s — STEP five — LED brightness periodic mod (^ triangle glyph, breathing) + white
#            audio: keep the 8-ch bed; ch5/6/7 revert to tones (noise/mono off)
S 40000 default 20 "this is a test"
S 42000 default 20 "five"
40000 8 50 ^10:60:2000 255 255 255 1   # mask1: white, brightness triangle mod 10<->60 / 2 s, 8 Hz
A 40000 247 0 50 0 5 0 0        # ch5 sine (white noise off)
A 40000 262 0 50 0 6 0 2        # ch6 triangle (binaural off)
# ch7 keeps its step-2 mono tone (220 Hz, freqR=0); ch8 keeps step-4 stereo-R tone

# ===== 50 s — STEP six — closing: ~5 s linear fade-out of all 8 audio channels + LED
S 50000 default 20 "this is a test"
S 52000 default 20 "six"
50000 0 50 >40 128 0 255 1      # LED brightness ramp -> 0 at fade end (purple)
A 50000 - - >50 - 1            # hold vol then ramp to 0 (target at 55 s)
A 50000 - - >50 - 2
A 50000 - - >50 - 3
A 50000 - - >45 - 4
A 50000 - - >50 - 5
A 50000 - - >50 - 6
A 50000 - - >45 - 7
A 50000 - - >45 - 8
A 55000 - - 0 - 1             # fade-out targets (~5 s): all 8 channels to zero
A 55000 - - 0 - 2
A 55000 - - 0 - 3
A 55000 - - 0 - 4
A 55000 - - 0 - 5
A 55000 - - 0 - 6
A 55000 - - 0 - 7
A 55000 - - 0 - 8
55000 0 50 0 128 0 255 1       # LED brightness reaches 0
