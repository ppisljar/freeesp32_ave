# 23_gateway_focus21_RGB.ledc — Gateway Focus 21 "The Bridge", RGB inner/outer build
# RGB variant of 23_gateway_focus21. Audio + speech IDENTICAL (theta septon base + 16.2 Hz
# beta signature; HEADPHONES REQUIRED). *** SAFETY-CRITICAL: 16 Hz is AUDIO-ONLY; the LED
# is pinned to 4 Hz theta the ENTIRE session and NEVER flickers at 16 Hz. *** On this build
# the LED is inner violet (mask 9, 90,0,200) + outer calm-blue (mask 6, 32,96,255), 180
# antiphase, SINE gate. Brightness <=25%. See base header for full method/safety.
#
# LED: time freq duty bright R G B mask [env phase]

# --- Prep / fade-in: calm 4 Hz SEPTON theta + phased pink bed + LED ease in ---
0 4 50 >0 90 0 200 9 1 0        # inner violet: 4 Hz sine, fade-in
0 4 50 >0 32 96 255 6 1 180     # outer blue: antiphase
A 0 200 0 >0 0 7 204 7  # septon a 200->204 (4 Hz); vol 0->22
A 0 204 0 >0 0 8 208 7  # septon b 204->208
A 0 208 0 >0 0 9 212 7  # septon c 208->212
A 0 200 ~-100:100:6000 >0 0 10 0 5   # ch10 phased PINK bed; pan L<->R 6 s; vol 0->8
S 3000 default 20 "Settle in and let the body grow still. Breathe slowly, easily, and let yourself relax."
15000 4 50 22 90 0 200 9 1 0    # inner: 22% reached
15000 4 50 22 32 96 255 6 1 180 # outer
30000 4 50 ~16:24:12000 90 0 200 9 1 0   # inner: breathing 16<->24%
30000 4 50 ~16:24:12000 32 96 255 6 1 180 # outer
A 60000 200 0 44 0 7 204 7  # septon a holds 22
A 60000 204 0 44 0 8 208 7  # septon b holds 22
A 60000 208 0 44 0 9 212 7  # septon c holds 22
A 60000 200 ~-100:100:6000 16 0 10 0 5   # ch10 pink bed holds 8

# --- Theta base: bring in 250/300[4.0] ---
A 180000 250 0 >0 0 2 254 7  # ch2 theta 250[4.0]; vol 0->30
A 180000 300 0 >0 0 3 304 7  # ch3 theta 300[4.0]
S 180000 default 20 "Sinking into a calm, steady theta — mind awake, body asleep. Rest at the threshold."
A 240000 250 0 60 0 2 254 7  # ch2 holds 30
A 240000 300 0 60 0 3 304 7  # ch3 holds 30

# --- Transition to Focus 21: fade IN 16.2 Hz beta (AUDIO ONLY) ---
A 480000 600 0 >0 0 4 616.2 7  # ch4 600[16.2] beta; vol 0->18
A 480000 750 0 >0 0 5 766.2 7  # ch5 750[16.2] beta
A 480000 900 0 >0 0 6 916.2 7  # ch6 900[16.2] beta
S 480000 default 20 "Moving now toward Focus Twenty-One. A brighter, clearer edge begins to open."
A 600000 600 0 36 0 4 616.2 7  # ch4 holds 18
A 600000 750 0 36 0 5 766.2 7  # ch5 holds 18
A 600000 900 0 36 0 6 916.2 7  # ch6 holds 18

# --- Hold at the Bridge: full stack, steady ---
S 720000 default 20 "You are at the Bridge — the edge of the physical. Open, aware, and unafraid. Simply notice what is here."
S 1200000 default 20 "Steady and clear. Rest at the boundary and let whatever comes, come."

# --- Return: fade the 16 Hz beta out ---
A 1680000 600 0 >36 0 4 616.2 7  # ch4 beta fades 18->0
A 1680000 750 0 >36 0 5 766.2 7  # ch5 beta fades out
A 1680000 900 0 >36 0 6 916.2 7  # ch6 beta fades out
S 1680000 default 20 "Gently now, stepping back from the edge, returning toward the calm theta."
A 1800000 600 0 0 0 4 616.2 7  # ch4 silent
A 1800000 750 0 0 0 5 766.2 7  # ch5 silent
A 1800000 900 0 0 0 6 916.2 7  # ch6 silent

# --- Soft close: fade theta base + LED to zero ---
1860000 4 50 >22 90 0 200 9 1 0     # inner: soft fade 22->0
1860000 4 50 >22 32 96 255 6 1 180  # outer
A 1860000 200 0 >44 0 7 204 7  # septon a fades out
A 1860000 204 0 >44 0 8 208 7  # septon b fades out
A 1860000 208 0 >44 0 9 212 7  # septon c fades out
A 1860000 250 0 >60 0 2 254 7  # ch2 theta fades out
A 1860000 300 0 >60 0 3 304 7  # ch3 theta fades out
A 1860000 200 ~-100:100:6000 >16 0 10 0 5   # ch10 pink bed fades out
S 1920000 default 20 "Coming all the way back to the room now, calm, clear, and whole."
A 1980000 200 0 0 0 7 204 7  # end: septon a silent
A 1980000 204 0 0 0 8 208 7  # septon b silent
A 1980000 208 0 0 0 9 212 7  # septon c silent
A 1980000 250 0 0 0 2 254 7
A 1980000 300 0 0 0 3 304 7
A 1980000 200 ~-100:100:6000 0 0 10 0 5   # ch10 pink bed silent
1980000 4 50 0 90 0 200 9 1 0       # inner off
1980000 4 50 0 32 96 255 6 1 180    # outer off

S 1980000 default 20 "WAKE UP!"
S 1990000 default 40 "WAKE UP!"
S 2000000 default 50 "WAKE UP!"
S 2010000 default 60 "WAKE UP!"
