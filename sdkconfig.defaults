# Project defaults — applied when sdkconfig is regenerated.
# Custom dual-boot OTA partition table (partitions.csv): ota_0 = main app
# (0x200000), ota_1 = standalone OTA updater (0xB0000), plus a 512 KB SPIFFS
# "storage" partition for the web UI assets (served by web_server.c from /spiffs)
# and a 512 KB "cfgfs". App-rollback stays OFF (no esp_ota_mark_app_valid needed).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# Phase 3 (runtime_settings_plan.md): compile ALL LED backends and ALL audio
# codecs into one firmware; the active one is selected at runtime from settings.
# The *_SUPPORT_* bools gate which backend/codec code is compiled in (all on).
# The *_DEFAULT_* choices only seed the runtime store on first boot — they match
# the previously-active compile-time selection (DIRECT LED, ES8388 codec).
CONFIG_LED_SUPPORT_NEOPIXEL=y
CONFIG_LED_SUPPORT_DOTSTAR=y
CONFIG_LED_SUPPORT_DIRECT=y
CONFIG_LED_DEFAULT_BACKEND_DIRECT=y
CONFIG_AUDIO_SUPPORT_AC101=y
CONFIG_AUDIO_SUPPORT_ES8388=y
CONFIG_AUDIO_SUPPORT_TLV320DAC3101=y
CONFIG_AUDIO_DEFAULT_CODEC_ES8388=y

# WebSocket server support (bg_websocket_pcm_push_plan.md — /api/bg-ws raw-PCM ingest)
CONFIG_HTTPD_WS_SUPPORT=y

# Per-target defaults live in sdkconfig.defaults.<target> (auto-loaded by IDF
# on top of this file): sdkconfig.defaults.esp32 for the classic boards,
# sdkconfig.defaults.esp32s3 for the YB-ESP32-S3-DAC. See legacyesp32.md.
